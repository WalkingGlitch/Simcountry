// ==UserScript==
// @name         Simcountry Cash Log — endless, sort, filter
// @namespace    https://simcountry.com/userscripts/cash-log-endless
// @version      1.5.0
// @author       TheWalkingGlitch
// @description  Sort, filter, and cap the Cash Log, Recent Sales (tsl), and Recent Purchases (tbl). Older pages come only from the page's own next link or Next form.
// @match        *://*.simcountry.com/*
// @match        *://simcountry.com/*
// @run-at       document-idle
// @grant        none
// ==/UserScript==

/*
 * Cash Log is not a separate navigation. The tab calls
 *   deskmenu_smartexec('cfinance&miCountryName=...&miDesktopTab=6')
 * which POSTs /cgi-bin/cgiw?jxGetDesktopApplet&miAppletID=cfinance&miDesktopTab=6
 * and writes the body into #da_cloned_contents. The address bar stays put.
 *
 * Finance tables repeat [value][spacer or 14px history icon]. Those spacers
 * were the bogus columns. This version parses the applet response itself, not
 * only table.data, and drops a column only when both its header and its cells
 * are empty.
 *
 * The Firefox profile of this tab shows one fetch and no paging call:
 *   deskmenu_smartexec -> deskmenu_applet -> dtLoadApplet -> jxRequestExec
 *   -> XMLHttpRequest.open/send -> jxGotDesktopAppletXL
 * which writes the body into #da_cloned_contents. Guessed miFrom / miPageStartPos
 * requests are not part of that path; they were pulling other finance tables
 * into this log. This version reads only the cash-log table from that payload.
 *
 * Recent Sales and Recent Purchases are full pages:
 *   /cgi-bin/cgiw?tsl
 *   /cgi-bin/cgiw?tbl
 * The table lives in #pw_contents. Paging is a GET form, not an applet cursor:
 *   action /cgi-bin/cgi2nova
 *   SN_ADDRESS=wwwCountry
 *   SN_METHOD=tsl|tbl
 *   miEntityKind, miEntityNumber
 *   miTradeTransaction=<last row on this page>
 *   next=Next >
 * Page 1 has only Next. Later pages also have First (no transaction id).
 * The next page repeats the cursor row as its first row, then older trades.
 * This script submits that Next form and drops the repeated row. It does not
 * invent miFrom / miPageStartPos. Unit price scales as quality/100 against the
 * Q100 column, so line value is quantity times the price received or paid.
 */
(function () {
  'use strict';

  var PANEL = 'sc-cashlog-endless';
  var MONTHS = { jan:1, january:1, feb:2, february:2, mar:3, march:3, apr:4, april:4, may:5, jun:6, june:6, jul:7, july:7, aug:8, august:8, sep:9, sept:9, september:9, oct:10, october:10, nov:11, november:11, dec:12, december:12 };
  var MNAME = ['','Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  var lastHtml = '';
  var lastReq = '';
  var tradeHtml = '';
  var nextUrl = '';

  var state = {
    mode: 'cash', tradeKind: '',
    rows: [], headers: [], kinds: [],
    sortCol: -1, sortDir: -1,
    filter: '', flow: 'all', month: 'all', breaks: true,
    product: 'all', minQ: 0,
    capOn: true, capN: 1000,
    rendered: 120, loading: false, exhausted: false,
    scheme: '', offset: 21, status: '', sig: '', seen: {}, cursors: {}
  };
  var tipTimer = null, tipEl = null;

  function addStyle() {
    if (document.getElementById('sccl-style')) return;
    var s = document.createElement('style');
    s.id = 'sccl-style';
    s.textContent = [
      '#'+PANEL+'{box-sizing:border-box;margin:12px 0 18px;clear:both;font-family:arial,helvetica,sans-serif;color:#000;}',
      '#'+PANEL+' *{box-sizing:border-box;}',
      '#'+PANEL+' .cap{font-weight:bold;font-size:12pt;padding:0 0 .3em;}',
      '#'+PANEL+' .tools{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;margin:0 0 6px;font-size:10pt;}',
      '#'+PANEL+' .tools label{display:inline-flex;align-items:center;gap:4px;white-space:nowrap;}',
      '#'+PANEL+' .tools input,#'+PANEL+' .tools select,#'+PANEL+' .tools button{font:inherit;padding:2px 6px;}',
      '#'+PANEL+' .tools button{cursor:pointer;}',
      '#'+PANEL+' .stat{font-size:9pt;margin:0 0 6px;color:#333;}',
      '#'+PANEL+' .frame{border:1px solid #4b4b4b;overflow:visible;background:#fff;}',
      '#'+PANEL+' table{border-collapse:collapse;width:100%;table-layout:fixed;font-size:10pt;}',
      '#'+PANEL+' th,#'+PANEL+' td{padding:.28em .45em;border-right:1px solid rgba(75,75,75,.4);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#111;}',
      '#'+PANEL+' th:last-child,#'+PANEL+' td:last-child{border-right:none;}',
      '#'+PANEL+' thead th{position:sticky;top:0;z-index:2;cursor:pointer;background:#336699;color:#fff;font-weight:bold;text-align:left;}',
      '#'+PANEL+' .num{text-align:right;}',
      '#'+PANEL+' tr.month td{font-weight:bold;background:#eef3f8;border-right:none;border-top:1px solid #4b4b4b;border-bottom:1px solid #4b4b4b;white-space:normal;overflow:visible;}',
      '#'+PANEL+' tr.pad td{padding:0;border:none;background:transparent;}',
      '#'+PANEL+' tr.inc td.num{color:#0a7a20;} #'+PANEL+' tr.out td.num{color:#b00000;}',
      '#'+PANEL+' tbody tr.row:nth-child(even) td{background:rgba(51,102,153,.06);}',
      '#sccl-tip{position:fixed;z-index:100001;display:none;max-width:440px;background:#fff;color:#111;border:1px solid #4b4b4b;box-shadow:0 8px 22px rgba(0,0,0,.3);padding:8px 10px;font:10pt arial,helvetica,sans-serif;white-space:pre-wrap;pointer-events:none;}'
    ].join('');
    (document.head || document.documentElement).appendChild(s);
    tipEl = document.createElement('div');
    tipEl.id = 'sccl-tip';
    document.body.appendChild(tipEl);
  }

  function textOf(node) {
    if (!node) return '';
    var c = node.cloneNode(true);
    var imgs = c.querySelectorAll ? c.querySelectorAll('img') : [];
    for (var i = 0; i < imgs.length; i++) imgs[i].remove();
    return (c.innerText || c.textContent || '').replace(/\u00a0/g, ' ').replace(/\s+/g, ' ').trim();
  }
  function esc(s) {
    return String(s == null ? '' : s).replace(/&/g, '&').replace(/</g, '<').replace(/>/g, '>').replace(/"/g, '"');
  }
  function blank(s) { return !String(s || '').trim(); }

  function financeRoot() {
    return document.getElementById('da_cloned_contents') || document.getElementById('ctg_contents') || document.getElementById('pw_contents');
  }
  function cashOpen() {
    if (/miDesktopTab=6\b/.test(location.href) || /miDesktopTab=6\b/.test(lastHtml.slice(0, 400))) return true;
    var sel = document.querySelectorAll('li.desktop_tabpage_selected a');
    for (var i = 0; i < sel.length; i++) {
      var blob = (sel[i].getAttribute('onclick') || '') + ' ' + (sel[i].getAttribute('title') || '') + ' ' + sel[i].textContent;
      if (/miDesktopTab=6\b|cash log|recent cash/i.test(blob)) return true;
    }
    var root = financeRoot();
    return !!(root && /recent cash changes|cash log/i.test(root.textContent || ''));
  }
  function tradeKindFrom(href, text) {
    href = href || '';
    text = text || '';
    if (/[?&]tsl(?:&|=|$)/.test(href) || /SN_METHOD=tsl\b/.test(href) || /recent sales/i.test(text)) return 'sales';
    if (/[?&]tbl(?:&|=|$)/.test(href) || /SN_METHOD=tbl\b/.test(href) || /recent purchases/i.test(text)) return 'purchases';
    return '';
  }
  function tradeRoot() {
    var nodes = [
      document.getElementById('pw_contents'),
      document.getElementById('da_cloned_contents'),
      document.getElementById('da_contents'),
      document.getElementById('ctg_contents'),
      document.body
    ];
    for (var i = 0; i < nodes.length; i++) {
      if (nodes[i] && /recent sales|recent purchases/i.test(nodes[i].textContent || '')) return nodes[i];
    }
    return financeRoot();
  }
  function tradeKind() {
    var root = tradeRoot();
    var text = ((root && root.textContent) || '') + ' ' + (document.title || '');
    return tradeKindFrom(location.href, text) || tradeKindFrom('', tradeHtml) || '';
  }
  function titleWidth() {
    var title = document.getElementById('cdh_title0');
    var bar = title && title.closest ? title.closest('table') : document.querySelector('table.dt_titlebar');
    var node = bar || title;
    if (!node) return null;
    var w = node.getBoundingClientRect().width;
    if (w < 240 && node.parentNode) w = node.parentNode.getBoundingClientRect().width;
    return w > 240 ? Math.floor(w) : null;
  }
  function panelWidth() {
    var w = titleWidth();
    if (w) return w;
    if (state.mode !== 'trade') return null;
    var root = financeRoot();
    var table = root && root.querySelector('table.datagroup');
    var node = table || root;
    if (!node || !node.getBoundingClientRect) return null;
    var ww = node.getBoundingClientRect().width;
    return ww > 240 ? Math.floor(ww) : null;
  }

  function parseAmount(raw) {
    if (!raw) return null;
    var s = String(raw).replace(/SC\$/ig, '').trim();
    if (!/\d/.test(s)) return null;
    var neg = /^-|^\(|−/.test(s);
    var m = s.replace(/[(),]/g, '').match(/([+-]?\d+(?:\.\d+)?)\s*([KMBT])?/i);
    if (!m) return null;
    var n = parseFloat(m[1]);
    if (!isFinite(n)) return null;
    var suf = (m[2] || '').toUpperCase();
    n *= suf === 'T' ? 1e12 : suf === 'B' ? 1e9 : suf === 'M' ? 1e6 : suf === 'K' ? 1e3 : 1;
    if (neg && n > 0) n = -n;
    return n;
  }
  function formatAmount(n) {
    if (n == null || !isFinite(n)) return '';
    var a = Math.abs(n), v = a, suf = '', sign = n < 0 ? '-' : '+';
    if (a >= 1e12) { v = a / 1e12; suf = 'T'; }
    else if (a >= 1e9) { v = a / 1e9; suf = 'B'; }
    else if (a >= 1e6) { v = a / 1e6; suf = 'M'; }
    else if (a >= 1e3) { v = a / 1e3; suf = 'K'; }
    return sign + v.toFixed(v >= 100 ? 0 : v >= 10 ? 1 : 2) + suf + ' SC$';
  }
  function formatQty(n) {
    if (n == null || !isFinite(n)) return '';
    return Math.round(n).toLocaleString('en-US');
  }
  function parseGameDate(raw) {
    if (!raw) return null;
    var s = String(raw).replace(/,/g, ' ');
    var m = s.match(/\b([A-Za-z]{3,9})\.?\s+(\d{1,2})(?:st|nd|rd|th)?\s+(\d{3,5})\b/);
    if (m && MONTHS[m[1].toLowerCase()]) { var mo = MONTHS[m[1].toLowerCase()]; return { month: mo, day: +m[2], year: +m[3], label: MNAME[mo] + ' ' + m[3] }; }
    m = s.match(/\b(\d{1,2})\s+([A-Za-z]{3,9})\.?\s+(\d{3,5})\b/);
    if (m && MONTHS[m[2].toLowerCase()]) { mo = MONTHS[m[2].toLowerCase()]; return { month: mo, day: +m[1], year: +m[3], label: MNAME[mo] + ' ' + m[3] }; }
    m = s.match(/\b([A-Za-z]{3,9})\.?\s+(\d{3,5})\b/);
    if (m && MONTHS[m[1].toLowerCase()]) { mo = MONTHS[m[1].toLowerCase()]; return { month: mo, day: 0, year: +m[2], label: MNAME[mo] + ' ' + m[2] }; }
    return null;
  }
  function dateValue(d) { return d ? d.year * 10000 + d.month * 100 + (d.day || 0) : 0; }

  function docFrom(html) {
    var s = String(html || '');
    var idx = s.indexOf(':JXtitle>');
    if (s.indexOf('<!JXtitle:') === 0 && idx !== -1) s = s.slice(idx + 9);
    var doc = document.implementation.createHTMLDocument('c');
    doc.documentElement.innerHTML = s;
    return doc;
  }

  function innermostTables(root) {
    var all = root.querySelectorAll('table');
    var out = [];
    for (var i = 0; i < all.length; i++) {
      if (all[i].querySelector('table')) continue;
      if (all[i].closest && all[i].closest('#' + PANEL)) continue;
      out.push(all[i]);
    }
    return out;
  }

  function parseTable(table) {
    var trs = Array.prototype.slice.call(table.querySelectorAll('tr'));
    var headerIdx = -1, headerTexts = [];
    for (var i = 0; i < trs.length; i++) {
      if (trs[i].querySelector('.datacolheader, th.datacolheader')) {
        headerIdx = i;
        headerTexts = Array.prototype.map.call(trs[i].querySelectorAll('th, td'), textOf);
        break;
      }
    }
    var body = [], carry = null;
    for (var r = headerIdx + 1; r < trs.length; r++) {
      var cells = Array.prototype.slice.call(trs[r].querySelectorAll('th, td'));
      var texts = cells.map(textOf);
      if (texts.every(blank)) continue;
      var bits = texts.filter(function (t) { return !blank(t); });
      var joined = bits.join(' ');
      var asDate = parseGameDate(joined);
      if (asDate && bits.length === 1 && parseAmount(joined) == null) { carry = asDate; continue; }
      body.push({ texts: texts, carry: carry, cells: cells });
    }
    var width = headerTexts.length;
    body.forEach(function (row) { if (row.texts.length > width) width = row.texts.length; });
    var keep = [];
    for (var c = 0; c < width; c++) {
      var filled = 0;
      body.forEach(function (row) { if (!blank(row.texts[c])) filled++; });
      var head = headerTexts[c] || '';
      var icon = false;
      if (body[0] && body[0].cells[c] && body[0].cells[c].querySelector) {
        var img = body[0].cells[c].querySelector('img');
        icon = !!(img && blank(head) && filled === 0);
      }
      if (icon) continue;
      if (!blank(head) || filled > 0) keep.push(c);
    }
    if (!keep.length) return null;
    var headers = keep.map(function (idx) {
      var h = headerTexts[idx] || '';
      return blank(h) ? '' : h;
    });
    headers = headers.map(function (h, n) {
      if (!blank(h)) return h;
      var sample = '';
      for (var i = 0; i < body.length && i < 8; i++) sample += ' ' + (body[i].texts[keep[n]] || '');
      if (parseGameDate(sample)) return 'Date';
      if (parseAmount(sample) != null) return 'Amount';
      return 'Detail';
    });
    var rows = [];
    body.forEach(function (row) {
      var texts = keep.map(function (idx) { return row.texts[idx] || ''; });
      if (texts.every(blank)) return;
      var dateHit = null, amountHit = null;
      texts.forEach(function (t, i) {
        var d = parseGameDate(t);
        if (d && !dateHit) dateHit = d;
        var cell = row.cells[keep[i]];
        var font = cell && cell.querySelector ? cell.querySelector('font') : null;
        var color = ((cell && cell.getAttribute && cell.getAttribute('color')) || '') + ' ' + (font ? font.getAttribute('color') || '' : '');
        var amt = parseAmount(t);
        if (amt == null) return;
        var head = (headers[i] || '').toLowerCase();
        if (/balance|total cash|cash position/.test(head)) return;
        if (!/change|amount|paid|received|income|cost|spend/.test(head) && amountHit != null) return;
        if (/red/i.test(color) && amt > 0) amt = -amt;
        if (/change|amount|paid|received/.test(head)) amountHit = amt;
        else if (amountHit == null) amountHit = amt;
      });
      var date = dateHit || row.carry;
      rows.push({
        texts: texts, date: date,
        month: date ? { month: date.month, year: date.year, label: date.label } : null,
        amount: amountHit, key: texts.join('|').toLowerCase()
      });
    });
    if (!rows.length) return null;
    var kinds = headers.map(function (h, col) {
      var hl = h.toLowerCase();
      if (/date|month|when|time/.test(hl)) return 'date';
      if (/amount|change|cash|income|cost|paid|balance|sum|quantity|quality|price|value/.test(hl)) return 'num';
      var dates = 0, nums = 0;
      rows.slice(0, 10).forEach(function (row) {
        if (parseGameDate(row.texts[col])) dates++;
        if (parseAmount(row.texts[col]) != null) nums++;
      });
      if (dates >= 2) return 'date';
      if (nums >= 2) return 'num';
      return 'text';
    });
    return { headers: headers, kinds: kinds, rows: rows, score: rows.length + (headers.join(' ').match(/cash|amount|date/i) ? 10 : 0) };
  }

  function colIndex(headers, test) {
    for (var i = 0; i < headers.length; i++) if (test(headers[i].toLowerCase())) return i;
    return -1;
  }
  function tradeShape(parsed, kind) {
    var headers = parsed.headers;
    var iProd = colIndex(headers, function (h) { return h.indexOf('product') !== -1; });
    var iWhen = colIndex(headers, function (h) { return /when|date/.test(h); });
    var iQty = colIndex(headers, function (h) { return h.indexOf('quantity') !== -1; });
    var iQual = colIndex(headers, function (h) { return h.indexOf('quality') !== -1; });
    var iUnit = colIndex(headers, function (h) { return /price received|price paid/.test(h); });
    var iQ100 = colIndex(headers, function (h) { return h === 'price'; });
    var iEvent = colIndex(headers, function (h) { return /happened|event/.test(h); });
    var sign = kind === 'purchases' ? -1 : 1;
    var rows = parsed.rows.map(function (row) {
      var prodCell = iProd >= 0 ? row.texts[iProd] : '';
      var parts = prodCell.split(/\s+on\s+/i);
      var product = parts[0] || prodCell;
      var market = parts.length > 1 ? parts.slice(1).join(' on ') : '';
      var qty = iQty >= 0 ? parseAmount(row.texts[iQty]) : null;
      var quality = iQual >= 0 ? parseAmount(row.texts[iQual]) : null;
      var unit = iUnit >= 0 ? parseAmount(row.texts[iUnit]) : null;
      var q100 = iQ100 >= 0 ? parseAmount(row.texts[iQ100]) : null;
      var line = qty != null && unit != null ? qty * unit : null;
      if (!product && qty == null && unit == null) return null;
      var when = iWhen >= 0 ? row.texts[iWhen] : (row.date ? row.date.label : '');
      var event = iEvent >= 0 ? row.texts[iEvent] : '';
      var texts = [
        product, market, when,
        qty == null ? '' : formatQty(qty),
        quality == null ? '' : String(Math.round(quality)),
        unit == null ? '' : formatQty(unit) + ' SC$',
        q100 == null ? '' : formatQty(q100) + ' SC$',
        line == null ? '' : formatAmount(sign * line),
        event
      ];
      return {
        texts: texts,
        date: row.date,
        month: row.month,
        amount: line == null ? null : sign * line,
        qty: qty, quality: quality, product: product, market: market,
        key: [product, market, when, qty, quality, unit, event].join('|').toLowerCase()
      };
    }).filter(Boolean);
    return {
      headers: ['Product', 'Market', 'When', 'Quantity', 'Quality', 'Unit price', 'Q100 price', 'Line value', 'What happened?'],
      kinds: ['text', 'text', 'date', 'num', 'num', 'num', 'num', 'num', 'text'],
      rows: rows,
      score: rows.length + 100
    };
  }

  function parseRoot(root, mode) {
    var tables = innermostTables(root);
    var best = null;
    tables.forEach(function (table) {
      var cap = '';
      var wrap = table.parentNode && table.parentNode.closest ? table.parentNode.closest('table') : null;
      if (wrap) cap = textOf(wrap.querySelector('caption'));
      var near = '';
      var hop = table.parentNode;
      for (var n = 0; n < 4 && hop; n++) { near += ' ' + textOf(hop); hop = hop.parentNode; }
      if (/profit\s*&\s*loss|expected full year|year to date|cash ytd/i.test(cap)) return;
      var parsed = parseTable(table);
      if (!parsed) return;
      if (mode === 'trade') {
        var named = /recent sales|recent purchases/i.test(cap + ' ' + near);
        var tradeish = /when/.test(parsed.headers.join(' ').toLowerCase()) && /product|quality|quantity/.test(parsed.headers.join(' ').toLowerCase());
        if (!named && !tradeish) return;
        if (named) parsed.score += 100;
      } else {
        var namedCash = /cash log|recent cash/i.test(cap);
        if (namedCash) parsed.score += 100;
        else if (!/when|date/.test(parsed.headers.join(' ').toLowerCase()) || parsed.kinds.indexOf('num') === -1) return;
      }
      if (!best || parsed.score > best.score) best = parsed;
    });
    return best;
  }

  function merge(parsed) {
    if (!parsed) return 0;
    if (parsed.headers.length >= state.headers.length) { state.headers = parsed.headers; state.kinds = parsed.kinds; }
    var added = 0;
    parsed.rows.forEach(function (row) {
      if (!row.key || state.seen[row.key]) return;
      state.seen[row.key] = 1;
      state.rows.push(row);
      added++;
    });
    return added;
  }

  function capHit() {
    return !!(state.capOn && state.capN > 0 && state.rows.length >= state.capN);
  }
  function csvCell(s) {
    s = String(s == null ? '' : s);
    return /[",\r\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
  }
  function fileSlug(s) {
    return String(s || '').replace(/[\\/:*?"<>|]+/g, '').replace(/\s+/g, '-').replace(/[^A-Za-z0-9._-]+/g, '').replace(/-+/g, '-').replace(/^-|-$/g, '').slice(0, 40);
  }
  function exportCsv() {
    var rows = state.shown || [];
    var head = state.headers.concat(['Month', 'Signed amount']);
    var lines = [head.map(csvCell).join(',')];
    var first = '', last = '';
    rows.forEach(function (row) {
      var cells = row.texts.slice();
      cells.push(row.month ? row.month.label : '');
      cells.push(row.amount == null ? '' : String(row.amount));
      lines.push(cells.map(csvCell).join(','));
      var label = row.date ? row.date.label + (row.date.day ? '-' + row.date.day : '') : (row.month ? row.month.label : '');
      if (label && !first) first = label;
      if (label) last = label;
    });
    var country = fileSlug((document.getElementById('cdh_title0') || {}).textContent) || fileSlug((document.title || '').replace(/^Simcountry:\s*/i, '')) || 'country';
    var flow = state.mode === 'trade' ? (state.tradeKind || 'trade') : (state.flow === 'in' ? 'income' : state.flow === 'out' ? 'spending' : 'all');
    var month = state.month === 'all' ? 'all-months' : fileSlug(state.month);
    var range = first && last ? fileSlug(first) + '_to_' + fileSlug(last) : 'no-dates';
    var prefix = state.mode === 'trade' ? (state.tradeKind === 'purchases' ? 'purchases' : 'sales') : 'cash-log';
    var name = [prefix, country, flow, month, range, rows.length + 'rows'].filter(Boolean).join('_') + '.csv';
    var blob = new Blob([lines.join('\r\n')], { type: 'text/csv;charset=utf-8' });
    var a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = name;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(function () { URL.revokeObjectURL(a.href); }, 1000);
  }
  function countryQuery() {
    var a = document.querySelector('a[onclick*="miDesktopTab=6"]');
    var m = a && (a.getAttribute('onclick') || '').match(/miCountryName=([^&']+)/);
    var id = window.dtDesktopOwnerID || window.ckLoginCountry || '';
    var q = 'miAppletID=cfinance&miDesktopTab=6';
    if (m) q += '&miCountryName=' + m[1];
    if (id) q += '&miDesktopOwnerKind=' + (window.dtDesktopOwnerKind || 'c') + '&miDesktopOwnerID=' + id;
    return q;
  }
  function absUrl(raw) {
    if (!raw) return '';
    if (/^https?:/i.test(raw)) return raw;
    if (raw.charAt(0) === '/') return location.origin + raw;
    return location.origin + '/cgi-bin/cgiw?' + raw.replace(/^\?/, '');
  }
  function discoverNext(html) {
    var doc = docFrom(html);
    var nodes = doc.querySelectorAll('a, form, input');
    for (var i = 0; i < nodes.length; i++) {
      var n = nodes[i];
      var blob = ((n.getAttribute && (n.getAttribute('href') || '')) || '') + ' ' + ((n.getAttribute && n.getAttribute('onclick')) || '') + ' ' + (n.name || '') + ' ' + (n.value || '');
      if (/miTradeTransaction/.test(blob)) continue;
      var m = blob.match(/deskmenu_smartexec\('([^']*miDesktopTab=6[^']*)'\)/) || blob.match(/jxGetDesktopApplet[^'")\s]*miDesktopTab=6[^'")\s]*/);
      if (m && /miFrom|miTo|miPageStartPos|miPageSize|plNextPage/.test(blob)) return absUrl(m[1] || m[0]);
      if (n.href && /miDesktopTab=6/.test(n.href) && /miFrom|miPageStartPos/.test(n.href)) return n.href;
    }
    var ids = [];
    var re = /miTradeTransaction=(\d+)/g, mm;
    while ((mm = re.exec(html))) ids.push(mm[1]);
    if (!ids.length) return '';
    ids.sort();
    var base = lastReq || (location.origin + '/cgi-bin/cgiw?jxGetDesktopApplet&' + countryQuery());
    base = base.replace(/[&?]miTradeTransaction=\d+/, '');
    return base + (base.indexOf('?') === -1 ? '?' : '&') + 'miTradeTransaction=' + ids[0];
  }
  function tradeNextFrom(doc) {
    var forms = doc.querySelectorAll('form');
    for (var i = 0; i < forms.length; i++) {
      var form = forms[i];
      var next = form.querySelector('input[name="next"]');
      if (!next) continue;
      var method = form.querySelector('input[name="SN_METHOD"]');
      if (!method || !/^(tsl|tbl)$/i.test(method.value || '')) continue;
      var cursor = '';
      var params = [];
      var inputs = form.querySelectorAll('input');
      for (var j = 0; j < inputs.length; j++) {
        var inp = inputs[j];
        if (!inp.name) continue;
        if ((inp.type || '').toLowerCase() === 'submit' && inp.name !== 'next') continue;
        if (inp.name === 'miTradeTransaction') cursor = inp.value || '';
        params.push(encodeURIComponent(inp.name) + '=' + encodeURIComponent(inp.value == null ? '' : String(inp.value)));
      }
      if (!cursor) continue;
      var action = form.getAttribute('action') || '/cgi-bin/cgi2nova';
      if (!/^https?:/i.test(action)) action = location.origin + (action.charAt(0) === '/' ? action : '/' + action);
      return { url: action + (action.indexOf('?') === -1 ? '?' : '&') + params.join('&'), cursor: cursor };
    }
    return null;
  }

  function visible() {
    var q = state.filter.trim().toLowerCase();
    return state.rows.filter(function (row) {
      if (state.month !== 'all' && (!row.month || row.month.label !== state.month)) return false;
      if (state.mode !== 'trade') {
        if (state.flow === 'in' && !(row.amount > 0)) return false;
        if (state.flow === 'out' && !(row.amount < 0)) return false;
      } else {
        if (state.product !== 'all' && row.product !== state.product) return false;
        if (state.minQ && !(row.quality >= state.minQ)) return false;
      }
      if (q && row.texts.join(' ').toLowerCase().indexOf(q) === -1) return false;
      return true;
    });
  }
  function compare(a, b) {
    if (state.sortCol < 0) return 0;
    var kind = state.kinds[state.sortCol] || 'text';
    var av, bv, col = state.sortCol;
    if (kind === 'num') { av = parseAmount(a.texts[col]); if (av == null) av = a.amount || 0; bv = parseAmount(b.texts[col]); if (bv == null) bv = b.amount || 0; }
    else if (kind === 'date') { av = dateValue(parseGameDate(a.texts[col]) || a.date); bv = dateValue(parseGameDate(b.texts[col]) || b.date); }
    else { av = (a.texts[col] || '').toLowerCase(); bv = (b.texts[col] || '').toLowerCase(); }
    if (av < bv) return -state.sortDir;
    if (av > bv) return state.sortDir;
    return 0;
  }
  function totals(rows) {
    var inc = 0, out = 0, qty = 0;
    rows.forEach(function (row) {
      if (row.qty) qty += row.qty;
      if (row.amount == null) return;
      if (row.amount >= 0) inc += row.amount; else out += row.amount;
    });
    return { inc: inc, out: out, net: inc + out, qty: qty };
  }
  function ordered() { var rows = visible(); return state.sortCol < 0 ? rows : rows.slice().sort(compare); }

  function displayItems(rows) {
    if (!state.breaks) return rows.map(function (row) { return { type: 'row', row: row }; });
    var items = [], last = '\u0000', group = [];
    function flush() {
      if (!group.length) return;
      var label = group[0].month ? group[0].month.label : 'Undated';
      var g = totals(group);
      items.push({ type: 'month', label: label, n: group.length, inc: g.inc, out: g.out, net: g.net, qty: g.qty });
      group.forEach(function (row) { items.push({ type: 'row', row: row }); });
      group = [];
    }
    rows.forEach(function (row) {
      var label = row.month ? row.month.label : 'Undated';
      if (label !== last) { flush(); last = label; }
      group.push(row);
    });
    flush();
    return items;
  }
  function rowHtml(row) {
    var html = '<tr class="row ' + (row.amount > 0 ? 'inc' : row.amount < 0 ? 'out' : '') + '">';
    for (var c = 0; c < state.headers.length; c++) {
      var plain = row.texts[c] || '';
      html += '<td class="' + (state.kinds[c] === 'num' ? 'num' : '') + '" data-full="' + esc(plain) + '">' + esc(plain) + '</td>';
    }
    return html + '</tr>';
  }
  function paintStatus() {
    var panel = document.getElementById(PANEL);
    if (!panel) return;
    var rows = ordered();
    var tot = totals(state.shown || []);
    var st = panel.querySelector('.stat');
    if (!st) return;
    var tail = (state.loading ? ' · loading older…' : '') + (capHit() ? ' · stopped at cap' : '') + (state.exhausted ? ' · no further page' : '') + (state.status ? ' · ' + state.status : '');
    if (state.mode === 'trade') {
      st.textContent = (state.shown ? state.shown.length : 0) + ' on page / ' + rows.length + ' matching / ' + state.rows.length + ' loaded' + (state.capOn ? ' · cap ' + state.capN : '') + ' · qty ' + formatQty(tot.qty || 0) + ' · line ' + formatAmount(tot.net || 0) + tail;
    } else {
      st.textContent = (state.shown ? state.shown.length : 0) + ' on page / ' + rows.length + ' matching / ' + state.rows.length + ' loaded' + (state.capOn ? ' · cap ' + state.capN : '') + ' · net ' + formatAmount(tot.net || 0) + tail;
    }
  }
  function extendPage(all) {
    var panel = document.getElementById(PANEL);
    var body = panel && panel.querySelector('tbody');
    if (!body || !state.items) return;
    if (state.cursor >= state.items.length) return;
    var end = all ? state.items.length : Math.min(state.items.length, state.cursor + 40);
    var html = '';
    for (var i = state.cursor; i < end; i++) {
      var item = state.items[i];
      if (item.type === 'month') {
        var extra = state.mode === 'trade' ? ' · qty ' + formatQty(item.qty || 0) + ' · line ' + formatAmount(item.net) : ' · in ' + formatAmount(item.inc) + ' · out ' + formatAmount(item.out) + ' · net ' + formatAmount(item.net);
        html += '<tr class="month"><td colspan="' + Math.max(1, state.headers.length) + '">' + esc(item.label) + ' · ' + item.n + extra + '</td></tr>';
      } else {
        html += rowHtml(item.row);
        state.shown.push(item.row);
      }
    }
    state.cursor = end;
    body.insertAdjacentHTML('beforeend', html);
    paintStatus();
  }
  function hideTip() { clearTimeout(tipTimer); if (tipEl) tipEl.style.display = 'none'; }
  function armTip(ev) {
    hideTip();
    var cell = ev.target.closest && ev.target.closest('td');
    if (!cell || !cell.closest('#' + PANEL) || /month/.test(cell.parentNode.className || '')) return;
    var full = cell.getAttribute('data-full') || '';
    if (!full) return;
    var x = ev.clientX, y = ev.clientY;
    tipTimer = setTimeout(function () {
      tipEl.textContent = full;
      tipEl.style.display = 'block';
      tipEl.style.left = Math.max(8, Math.min(x + 14, window.innerWidth - tipEl.offsetWidth - 12)) + 'px';
      var top = y + 16;
      if (top + tipEl.offsetHeight > window.innerHeight - 8) top = y - tipEl.offsetHeight - 10;
      tipEl.style.top = Math.max(8, top) + 'px';
    }, 1000);
  }

  function render(force) {
    var panel = document.getElementById(PANEL);
    if (!panel) return;
    var w = panelWidth();
    if (w) { panel.style.width = w + 'px'; panel.style.maxWidth = '100%'; }
    var rows = ordered();
    var viewSig = [state.mode, state.sortCol, state.sortDir, state.filter, state.flow, state.month, state.breaks, state.product, state.minQ, state.headers.join('|')].join('~');
    var frame = panel.querySelector('.frame');
    if (!force && viewSig === state.viewSig && frame && frame.querySelector('tbody')) {
      state.items = displayItems(rows);
      extendPage(true);
      return;
    }
    state.viewSig = viewSig;
    state.items = displayItems(rows);
    state.shown = [];
    state.cursor = 0;
    var months = {};
    state.rows.forEach(function (row) { if (row.month) months[row.month.label] = dateValue(row.month); });
    var sel = panel.querySelector('[data-role="month"]');
    var monthHtml = '<option value="all">All game months</option>' + Object.keys(months).sort(function (a, b) { return months[b] - months[a]; }).map(function (m) {
      return '<option value="' + esc(m) + '"' + (m === state.month ? ' selected' : '') + '>' + esc(m) + '</option>';
    }).join('');
    if (sel && sel.innerHTML !== monthHtml) sel.innerHTML = monthHtml;
    var prod = panel.querySelector('[data-role="product"]');
    if (prod) {
      var products = {};
      state.rows.forEach(function (row) { if (row.product) products[row.product] = 1; });
      var prodHtml = '<option value="all">All products</option>' + Object.keys(products).sort().map(function (p) {
        return '<option value="' + esc(p) + '"' + (p === state.product ? ' selected' : '') + '>' + esc(p) + '</option>';
      }).join('');
      if (prod.innerHTML !== prodHtml) prod.innerHTML = prodHtml;
    }
    var head = '<tr>' + state.headers.map(function (h, i) {
      var kind = state.kinds[i] || 'text';
      var width = state.mode === 'trade'
        ? (kind === 'date' ? '12%' : kind === 'num' ? '10%' : '')
        : (kind === 'date' ? '16%' : kind === 'num' ? '14%' : '');
      return '<th class="' + (kind === 'num' ? 'num' : '') + '" data-col="' + i + '"' + (width ? ' style="width:' + width + '"' : '') + '>' + esc(h) + (state.sortCol === i ? (state.sortDir > 0 ? ' ▲' : ' ▼') : '') + '</th>';
    }).join('') + '</tr>';
    frame.innerHTML = '<table><thead>' + head + '</thead><tbody></tbody></table>';
    extendPage(true);
  }

  function loadOlder() {
    if (capHit()) {
      state.status = 'stopped at cap ' + state.capN;
      paintStatus();
      return;
    }
    if (state.loading || state.exhausted || !nextUrl) {
      if (!nextUrl) state.status = state.mode === 'trade' ? 'no Next form on this page' : 'no older-page link in the cash log response';
      paintStatus();
      return;
    }
    state.loading = true;
    var url = nextUrl;
    var method = state.mode === 'trade' ? 'GET' : 'POST';
    paintStatus();
    fetch(url, { method: method, credentials: 'include' }).then(function (r) { return r.text(); }).then(function (html) {
      if (state.mode === 'trade') {
        if (!/recent sales|recent purchases|SN_METHOD/i.test(html)) {
          state.exhausted = true;
          state.status = 'older request was not another sales or purchases page';
          return;
        }
        var doc = docFrom(html);
        var parsed = parseRoot(doc.body, 'trade');
        var added = merge(parsed ? tradeShape(parsed, state.tradeKind) : null);
        var nxt = tradeNextFrom(doc);
        if (!added || !nxt || nxt.url === url || state.cursors[nxt.cursor]) {
          state.exhausted = true;
          nextUrl = '';
          state.status = added ? '' : 'server returned no further trade rows';
        } else {
          state.cursors[nxt.cursor] = 1;
          nextUrl = nxt.url;
          state.status = state.rows.length + ' rows';
        }
        return;
      }
      if (!/cash log|recent cash|miDesktopTab=6|when/i.test(html)) {
        state.exhausted = true;
        state.status = 'older request was not another cash-log window';
        return;
      }
      var addedCash = merge(parseRoot(docFrom(html).body));
      var nxtCash = discoverNext(html);
      if (!addedCash || nxtCash === url) {
        state.exhausted = true;
        state.status = addedCash ? '' : 'server returned no further cash-log rows';
      } else {
        nextUrl = nxtCash;
        state.status = state.rows.length + ' rows';
      }
    }).catch(function () {
      state.exhausted = true;
      state.status = 'older page failed';
    }).then(function () {
      state.loading = false;
      render();
      if (!state.exhausted && nextUrl && !capHit()) loadOlder();
    });
  }

  function panelMarkup(mode, kind) {
    if (mode === 'trade') {
      var title = kind === 'purchases' ? 'Recent purchases — loaded history' : 'Recent sales — loaded history';
      return '<div class="cap">' + title + '</div><div class="tools"><label>Filter <input type="search" data-role="filter" placeholder="product, market, event"></label><label>Product <select data-role="product"><option value="all">All products</option></select></label><label>Min quality <input type="number" data-role="minq" min="0" step="1" style="width:4.5em"></label><label>Month <select data-role="month"><option value="all">All game months</option></select></label><label><input type="checkbox" data-role="breaks" checked> Month breaks</label><label><input type="checkbox" data-role="cap" checked> Cap rows <input type="number" data-role="capn" min="1" step="1" value="1000" style="width:5em"></label><button type="button" data-role="older">Load older</button><button type="button" data-role="csv">Export CSV</button><button type="button" data-role="reset">Reset sort</button></div><div class="stat"></div><div class="frame"></div>';
    }
    return '<div class="cap">Cash log — loaded history</div><div class="tools"><label>Filter <input type="search" data-role="filter" placeholder="any column"></label><label>Flow <select data-role="flow"><option value="all">All</option><option value="in">Income</option><option value="out">Spending</option></select></label><label>Month <select data-role="month"><option value="all">All game months</option></select></label><label><input type="checkbox" data-role="breaks" checked> Month breaks</label><label><input type="checkbox" data-role="cap" checked> Cap rows <input type="number" data-role="capn" min="1" step="1" value="1000" style="width:5em"></label><button type="button" data-role="older">Load older</button><button type="button" data-role="csv">Export CSV</button><button type="button" data-role="reset">Reset sort</button></div><div class="stat"></div><div class="frame"></div>';
  }
  function bindPanel(panel) {
    if (panel.getAttribute('data-bound') === '1') return;
    panel.setAttribute('data-bound', '1');
    panel.addEventListener('click', function (ev) {
      var th = ev.target.closest && ev.target.closest('th[data-col]');
      if (!th) return;
      ev.preventDefault(); ev.stopPropagation();
      var col = parseInt(th.getAttribute('data-col'), 10);
      if (state.sortCol === col) state.sortDir = -state.sortDir;
      else { state.sortCol = col; state.sortDir = state.kinds[col] === 'text' ? 1 : -1; }
      render(true);
    });
    panel.addEventListener('input', function (ev) {
      var role = ev.target.getAttribute && ev.target.getAttribute('data-role');
      if (role === 'filter') { state.filter = ev.target.value; render(true); }
      if (role === 'minq') {
        var qn = parseInt(ev.target.value, 10);
        state.minQ = qn > 0 ? qn : 0;
        render(true);
      }
    });
    panel.addEventListener('change', function (ev) {
      var role = ev.target.getAttribute && ev.target.getAttribute('data-role');
      if (role === 'flow') { state.flow = ev.target.value; render(true); }
      if (role === 'month') { state.month = ev.target.value; render(true); }
      if (role === 'product') { state.product = ev.target.value; render(true); }
      if (role === 'breaks') { state.breaks = ev.target.checked; render(true); }
      if (role === 'cap') { state.capOn = ev.target.checked; render(); }
      if (role === 'capn') {
        var n = parseInt(ev.target.value, 10);
        state.capN = n > 0 ? n : 1000;
        render();
      }
    });
    panel.addEventListener('mouseover', armTip);
    panel.addEventListener('mouseout', function (ev) { if (!(ev.relatedTarget && panel.contains(ev.relatedTarget))) hideTip(); });
    panel.addEventListener('click', function (ev) {
      var role = ev.target.getAttribute && ev.target.getAttribute('data-role');
      if (role === 'older') { state.exhausted = false; loadOlder(); }
      if (role === 'csv') exportCsv();
      if (role === 'reset') {
        state.sortCol = -1; state.filter = ''; state.flow = 'all'; state.month = 'all'; state.product = 'all'; state.minQ = 0;
        var f = panel.querySelector('[data-role="filter"]'); if (f) f.value = '';
        var flow = panel.querySelector('[data-role="flow"]'); if (flow) flow.value = 'all';
        var mq = panel.querySelector('[data-role="minq"]'); if (mq) mq.value = '';
        render(true);
      }
    });
  }
  function ensurePanel(anchor, mode, kind) {
    addStyle();
    var panel = document.getElementById(PANEL);
    if (!panel) {
      panel = document.createElement('div');
      panel.id = PANEL;
    }
    if (panel.getAttribute('data-mode') !== mode) {
      panel.setAttribute('data-mode', mode);
      panel.innerHTML = panelMarkup(mode, kind);
    } else if (mode === 'trade') {
      var cap = panel.querySelector('.cap');
      var want = kind === 'purchases' ? 'Recent purchases — loaded history' : 'Recent sales — loaded history';
      if (cap && cap.textContent !== want) cap.textContent = want;
    }
    bindPanel(panel);
    panel.style.display = '';
    var host = anchor && anchor.parentNode ? anchor.parentNode : financeRoot();
    if (host && panel.parentNode !== host) host.appendChild(panel);
    else if (!panel.parentNode) document.body.appendChild(panel);
    return panel;
  }

  function resetRows() {
    state.rows = []; state.seen = {}; state.headers = []; state.cursors = {};
    state.exhausted = false; nextUrl = '';
  }
  function scanTrade(kind) {
    state.mode = 'trade';
    state.tradeKind = kind;
    var root = tradeRoot();
    ensurePanel(root, 'trade', kind);
    var source = tradeHtml || '';
    var parsed = null;
    if (source && /recent sales|recent purchases|SN_METHOD/i.test(source)) parsed = parseRoot(docFrom(source).body, 'trade');
    if (!parsed && root) parsed = parseRoot(root, 'trade');
    if (!parsed || !parsed.rows.length) {
      state.status = source ? 'payload had no rows' : 'waiting for the sales or purchases table';
      render();
      return;
    }
    var shaped = tradeShape(parsed, kind);
    var sig = kind + '~' + shaped.rows.slice(0, 2).map(function (r) { return r.key; }).join('~') + '|' + shaped.rows.length;
    if (sig === state.sig && state.rows.length) return;
    state.sig = sig;
    resetRows();
    merge(shaped);
    var doc = source ? docFrom(source) : document;
    var nxt = tradeNextFrom(doc);
    if (nxt && !state.cursors[nxt.cursor]) {
      state.cursors[nxt.cursor] = 1;
      nextUrl = nxt.url;
      state.exhausted = false;
      state.status = '';
    } else {
      nextUrl = '';
      state.exhausted = true;
      state.status = 'no Next form on this page';
    }
    render(true);
    if (nextUrl && !capHit()) loadOlder();
  }
  function scanCash() {
    state.mode = 'cash';
    state.tradeKind = '';
    var root = financeRoot();
    ensurePanel(root, 'cash', '');
    var parsed = null;
    if (lastHtml && /miDesktopTab=6|cash log|recent cash/i.test(lastHtml)) parsed = parseRoot(docFrom(lastHtml).body);
    if (!parsed && root) parsed = parseRoot(root);
    if (!parsed || !parsed.rows.length) {
      state.status = lastHtml ? 'payload had no rows' : 'waiting for the cash log payload';
      render();
      return;
    }
    var sig = parsed.rows.slice(0, 2).map(function (r) { return r.key; }).join('~') + '|' + parsed.rows.length;
    if (sig === state.sig && state.rows.length) return;
    state.sig = sig;
    resetRows();
    merge(parsed);
    nextUrl = discoverNext(lastHtml || '');
    state.exhausted = !nextUrl;
    state.status = nextUrl ? '' : 'no older-page link in the cash log response';
    render(true);
    if (nextUrl && !capHit()) loadOlder();
  }
  function scan() {
    try {
      var kind = tradeKind();
      if (!kind && !cashOpen()) {
        var gone = document.getElementById(PANEL);
        if (gone) gone.style.display = 'none';
        return;
      }
      if (kind) scanTrade(kind);
      else scanCash();
    } catch (err) {
      ensurePanel(null, state.mode, state.tradeKind);
      state.status = err && err.message ? err.message : String(err);
      var st = document.querySelector('#' + PANEL + ' .stat');
      if (st) st.textContent = state.status;
    }
  }

  var timer = null;
  function schedule() { clearTimeout(timer); timer = setTimeout(scan, 200); }
  if (!window.__scclXhr) {
    window.__scclXhr = true;
    var open = XMLHttpRequest.prototype.open, send = XMLHttpRequest.prototype.send;
    XMLHttpRequest.prototype.open = function (m, url) { this.__scclUrl = String(url || ''); return open.apply(this, arguments); };
    XMLHttpRequest.prototype.send = function () {
      this.addEventListener('load', function () {
        var url = this.__scclUrl || '';
        var body = this.responseText || '';
        if (/jxGetDesktopApplet/i.test(url) && /miDesktopTab=6/.test(url)) {
          lastReq = url;
          lastHtml = body;
        }
        if (/recent sales|recent purchases/i.test(body) && /SN_METHOD|miTradeTransaction|tsl|tbl/i.test(body)) tradeHtml = body;
        if (/cfinance|jxGetDesktopApplet|tsl|tbl/i.test(url) || /recent sales|recent purchases/i.test(body)) schedule();
      });
      return send.apply(this, arguments);
    };
  }
  schedule();
  new MutationObserver(function (muts) {
    for (var i = 0; i < muts.length; i++) {
      var n = muts[i].target;
      if (n && n.closest && (n.closest('#' + PANEL) || n.id === 'sccl-tip')) return;
    }
    schedule();
  }).observe(document.documentElement, { childList: true, subtree: true });
})();
